# Copy this file to .env and fill in. Never commit .env (SEC-02).

# PostgreSQL 14+ (used by Prisma and the API)
DATABASE_URL=postgresql://simplelaw:simplelaw@localhost:5432/simplelaw?schema=public

# API
API_PORT=4000
NODE_ENV=development
# Origin of the Next.js app, for CORS (API-07)
WEB_ORIGIN=http://localhost:3000
# Set to true to expose Swagger at /api/docs (API-06). Must be false in production.
SWAGGER_ENABLED=true

# Security keys - generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# AES-256-GCM key for NIC numbers and Drive refresh tokens (DB-03, GD-02) - 64 hex chars
DATA_ENCRYPTION_KEY=
# HMAC-SHA256 key for nic_hash (DB-03) - 64 hex chars
NIC_HASH_KEY=
# Secret used to sign CSRF tokens (API-07)
CSRF_SECRET=

# Session cookie (AUTH-04)
SESSION_COOKIE_NAME=slc_session
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=12
# Set true behind HTTPS
COOKIE_SECURE=false

# SMTP (ADM-07) - any provider
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="SimpleLawCeylon <no-reply@example.com>"
# In development, when SMTP_HOST is empty, OTP codes are written to the API log instead of sent.

# Google Drive (GD-01)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/firm/drive/callback

# Platform file storage for slide images and firm logos (PUB-04)
UPLOAD_DIR=./uploads

# Web app
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
